  .faceless-home-channels-rail:empty,
  .faceless-home-made-by-rail:empty {
    display: none !important;
  }
  @media (min-width: 640px) {
    .faceless-home-channels-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
  @media (min-width: 768px) {
    #header-mobile {
      display: none !important;
    }
    .faceless-home-shell {
      margin-top: -0.25rem !important;
      margin-right: 0.25rem !important;
      margin-bottom: 0.25rem !important;
      margin-left: 0.25rem !important;
      border-radius: 1rem !important;
      border: 1px solid var(--qc-border-subtle, #ffffff0d) !important;
    }
    .faceless-home-hero-phone {
      display: none !important;
    }
    .faceless-home-hero-desktop {
      display: block !important;
    }
    .faceless-home-hero-desktop h1 {
      font-size: 3rem !important;
      line-height: 1.03 !important;
      letter-spacing: -0.12rem !important;
    }
    .faceless-home-hero-band {
      padding: 3.625rem 1.5rem !important;
    }
    .faceless-home-prompt-box {
      display: flex !important;
      flex-direction: row !important;
      align-items: flex-start !important;
    }
    .faceless-home-prompt-next {
      height: 5rem !important;
      width: 8rem !important;
    }
    .faceless-home-category-shelf {
      overflow: visible !important;
    }
    .faceless-home-made-by-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
  @media (min-width: 1024px) {
    .faceless-home-rails {
      gap: 3.5rem !important;
      padding-left: 3.75rem !important;
      padding-right: 3.75rem !important;
      padding-top: 2rem !important;
    }
    .faceless-home-rails:has(.faceless-home-channels-rail:empty) {
      gap: 2rem !important;
    }
    .faceless-home-section {
      gap: 1.75rem !important;
    }
    .faceless-home-section-heading {
      justify-content: flex-start !important;
      gap: 0.5rem !important;
    }
    .faceless-home-section-title {
      font-family: var(--hf-type-family-grotesk), sans-serif !important;
      font-size: var(--hf-type-size-800, 1.75rem) !important;
      font-weight: 700 !important;
      line-height: var(--hf-type-line-height-900, 1.875rem) !important;
      letter-spacing: var(--hf-type-letter-spacing-tight, -0.04em) !important;
      text-transform: uppercase !important;
      font-feature-settings: 'ss04' 1 !important;
    }
    .faceless-home-channels-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
    .faceless-home-made-by-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
  @media (max-width: 767.98px) {
    .faceless-home-hero-desktop {
      display: none !important;
    }
  }
