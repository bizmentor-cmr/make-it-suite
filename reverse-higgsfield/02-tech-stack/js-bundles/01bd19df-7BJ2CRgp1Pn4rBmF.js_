  .enterprise-studio-footer-shell {
    visibility: var(--hf-app-css-ready, hidden);
  }

  #header {
    color: var(--qc-text-tertiary, #a8a8a8);
  }

  :where(#header a:any-link) {
    color: inherit;
  }

  .enterprise-studio-page,
  .enterprise-studio-footer-shell {
    visibility: var(--enterprise-studio-css-ready, hidden);
  }
