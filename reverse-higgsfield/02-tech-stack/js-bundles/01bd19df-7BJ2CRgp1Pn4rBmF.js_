  .ms2-accent {
    font-family: 'Space Grotesk MS2', var(--hf-type-family-grotesk, 'Space Grotesk', system-ui, sans-serif);
    font-weight: 700;
    font-feature-settings: 'ss04' 1;
    text-transform: uppercase;
  }
  .ms2-hero-title {
    background-image: linear-gradient(to bottom, #fff, #666 90.278%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  html:has(.ms2-studio-scope),
  html:has(.ms2-studio-scope) body {
    overflow: hidden !important;
    background-color: var(--hf-color-background-primary, #131416) !important;
  }
  html:has(.ms2-studio-scope) .area-\\[footer\\] {
    display: none !important;
  }
  @media (min-width: 768px) {
    #header-mobile {
      display: none !important;
    }
    .ms2-landing-phone {
      display: none !important;
    }
    .ms2-landing-desktop {
      display: block !important;
      height: 100% !important;
      min-height: 0 !important;
    }
    .ms2-landing-desktop-shell {
      display: flex !important;
      height: 100% !important;
      min-height: 0 !important;
      gap: 0.25rem !important;
      padding: 0.25rem !important;
    }
    .ms2-sidebar {
      height: 100% !important;
    }
    .ms2-main-surface {
      min-width: 0 !important;
      border-radius: 1rem !important;
      border: 1px solid var(--qc-border-subtle, #ffffff0d) !important;
    }
    .ms2-hero-title {
      font-size: 32px !important;
      line-height: 36px !important;
      letter-spacing: -1.28px !important;
    }
    .ms2-composer-ssr-slot,
    [data-ms2-composer-ssr-slot] {
      display: flex !important;
      box-sizing: border-box !important;
      height: 7.5rem !important;
      width: 100% !important;
      max-width: 56rem !important;
      margin-left: auto !important;
      margin-right: auto !important;
      align-items: flex-end !important;
      gap: 0.25rem !important;
      padding-top: 0.25rem !important;
      padding-bottom: 0.25rem !important;
    }
    .ms2-composer-ssr-mode,
    .ms2-composer-ssr-panel {
      position: relative !important;
      isolation: isolate !important;
      display: flex !important;
      height: 7rem !important;
      flex-shrink: 0 !important;
      flex-direction: column !important;
      gap: 0.125rem !important;
      padding: 0.25rem !important;
      border: 0 !important;
      border-radius: 1.5rem !important;
      background-color: var(--hf-color-background-primary, #131416) !important;
      box-shadow: 0 0.25rem 0.25rem rgba(0, 0, 0, 0.24) !important;
    }
    .ms2-composer-ssr-mode {
      width: 4.5rem !important;
    }
    .ms2-composer-ssr-panel {
      min-width: 0 !important;
      flex: 1 1 auto !important;
      gap: 0.25rem !important;
    }
    .ms2-composer-ssr-mode::after,
    .ms2-composer-ssr-panel::after {
      content: '' !important;
      position: absolute !important;
      inset: 0 !important;
      pointer-events: none !important;
      border: 1px solid var(--hf-color-border-default, #ffffff24) !important;
      border-radius: inherit !important;
    }
    .ms2-composer-ssr-mode-slot {
      height: 3.1875rem !important;
      width: 4rem !important;
      border-radius: 1.25rem !important;
    }
    .ms2-composer-ssr-mode-slot[data-selected] {
      background-color: var(--hf-color-transparent-light-05, #ffffff0d) !important;
    }
    .ms2-composer-ssr-body {
      display: flex !important;
      min-width: 0 !important;
      min-height: 6.5rem !important;
      flex: 1 1 auto !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0.75rem !important;
      padding: 0.75rem !important;
      border-radius: 1.25rem !important;
      background-color: color-mix(in srgb, var(--hf-color-background-primary, #131416) 95%, var(--hf-color-text-primary, #fff) 5%) !important;
    }
    .ms2-preset-grid-density {
      container-type: inline-size;
    }
    .ms2-preset-grid-compact {
      display: flex !important;
      flex-direction: column !important;
      gap: 0.25rem !important;
    }
    .ms2-preset-grid-wide {
      display: none !important;
      flex-direction: column !important;
      gap: 0.25rem !important;
    }
    @container (min-width: 1360px) {
      .ms2-preset-grid-compact {
        display: none !important;
      }
      .ms2-preset-grid-wide {
        display: flex !important;
      }
    }
    [data-ms2-preset-row] {
      display: flex !important;
      align-items: flex-start !important;
      gap: 0.25rem !important;
    }
    [data-ms2-card-frame] {
      overflow: hidden !important;
      width: 100% !important;
      height: 100% !important;
    }
    [data-ms2-card-media],
    [data-ms2-card-media] img,
    [data-ms2-card-media] video {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      object-fit: cover !important;
      object-position: center !important;
    }
  }
  @media (max-width: 767.98px) {
    .ms2-landing-desktop {
      display: none !important;
    }
    html:has(.ms2-studio-scope) .area-\\[header\\],
    html:has(.ms2-studio-scope) #header,
    html:has(.ms2-studio-scope) #header-mobile,
    html:has(.ms2-studio-scope) #header-visual {
      display: none !important;
    }
  }
